{
  // MD013 (line length) is disabled: prose docs (README, ADRs, research notes)
  // wrap at whatever width reads well rather than a fixed column.
  "config": {
    "default": true,
    "MD013": false,
  },
  "globs": ["**/*.md", "**/*.markdown"],
  // ai-rulez context fragments are spliced under a "###" heading in the
  // generated AGENTS.md, so they cannot satisfy heading rules on their own;
  // the generated file is linted instead.
  "ignores": [".ai-rulez/context/**"],
  "gitignore": true,
}
